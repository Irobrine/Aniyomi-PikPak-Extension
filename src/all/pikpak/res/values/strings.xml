    <string name="pikpak_login_title">Log in with PikPak (web)</string>
    <string name="pikpak_login_summary">Tap here to open PikPak\'s website and import the session automatically.</string>
    <string name="pikpak_login_summary_logged_in">Logged in. Tap here to replace the saved PikPak session.</string>
    <string name="pikpak_logout_title">Log out of PikPak</string>
    <string name="pikpak_logout_summary">Forget the saved session and sign out of the PikPak page. Your files are not touched.</string>
    <string name="pikpak_logout_confirm_message">Forget the saved PikPak session? Your files are not touched.</string>
    <string name="pikpak_logout_action">Log out</string>
