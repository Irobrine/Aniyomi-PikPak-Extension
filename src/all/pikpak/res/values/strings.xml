    <string name="pikpak_info_folder_title">Folder structure</string>
    <string name="pikpak_info_folder_summary">Each folder directly inside My Pack is one anime. Season, part, cour, special and series sub-folders become seasons; disc, quality and subtitle folders are ignored. A folder without season folders shows its episodes directly.</string>
    <string name="pikpak_info_season_title">Season folders</string>
    <string name="pikpak_info_season_summary">Sub-folders inside an anime folder become seasons, and each season name is matched against the API separately.</string>
    <string name="pikpak_info_episode_title">Episode files</string>
    <string name="pikpak_info_episode_summary">Episode numbers are read from file names. Files without a number are numbered in name order.</string>
    <string name="pikpak_info_metadata_title">Metadata</string>
    <string name="pikpak_info_metadata_summary">Anime folder names are matched against AniList for cover, studio, characters, recommendations and related entries. Add a TMDB API key for non-anime movies and TV.</string>

    <string name="pikpak_torrents_title">Show torrent downloads</string>
    <string name="pikpak_torrents_summary">Items in My Pack that were added from magnet links.</string>
    <string name="pikpak_downloads_title">Show web downloads</string>
    <string name="pikpak_downloads_summary">Files in My Pack that were not added from magnet links.</string>

    <string name="pikpak_extra_folders_title">Extra folders</string>
    <string name="pikpak_extra_folders_summary">Anime folders inside these are listed at the top of the catalog. One folder ID or path per line. Example:\nMy Shared/Anime</string>
    <string name="pikpak_extra_folders_check_title">Check extra folders</string>
    <string name="pikpak_extra_folders_check_summary">Resolve the configured folders and report how many anime each one contains.</string>
    <string name="pikpak_extra_folders_none">No extra folders are configured.</string>
    <string name="pikpak_extra_folders_checking">Checking extra folders…</string>
    <string name="pikpak_extra_folders_report">%1$s: %2$d anime</string>
    <string name="pikpak_extra_folders_missing">%1$s: not found</string>

    <string name="pikpak_metadata_title">Fetch anime metadata</string>
    <string name="pikpak_metadata_summary">Use AniList for covers, studio, characters and suggestions. TMDB is used as fallback.</string>
    <string name="pikpak_tmdb_title">TMDB API key (optional)</string>
    <string name="pikpak_tmdb_summary">Used when AniList has no match, especially for movies and TV shows.</string>

