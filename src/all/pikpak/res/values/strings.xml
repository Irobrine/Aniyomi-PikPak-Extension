    <string name="pikpak_flat_folders_title">Detect flat folders</string>
    <string name="pikpak_flat_folders_summary">Probe the folders on a catalog page so a folder without sub-folders opens straight into episodes. Each folder is probed once and the answer is remembered.</string>

    <string name="pikpak_quality_title">Preferred resolution</string>
    <string name="pikpak_quality_summary">Only this resolution is offered for playback and downloads. When it is missing, the closest higher resolution is used, then lower ones.</string>
